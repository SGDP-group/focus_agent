[Unit]
Description=Focus Agent API Service
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/focus-agent
Environment=PATH=/opt/focus-agent/venv/bin
ExecStart=/opt/focus-agent/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/focus-agent

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=focus-agent

[Install]
WantedBy=multi-user.target
